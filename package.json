{
  "name": "kmoesync",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "自托管的 Kmoe 漫画订阅与同步服务：追更、按卷下载，存到 NAS 本地目录或 WebDAV 书库。",
  "license": "MIT",
  "author": "Kmoe Sync contributors",
  "homepage": "https://github.com/benis-me/kmoe-sync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benis-me/kmoe-sync.git"
  },
  "bugs": {
    "url": "https://github.com/benis-me/kmoe-sync/issues"
  },
  "keywords": [
    "kmoe",
    "manga",
    "comics",
    "self-hosted",
    "nas",
    "webdav",
    "komga",
    "bangumi",
    "epub",
    "mcp"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "dev:server": "bun --watch server/index.ts",
    "dev:fake": "KMOESYNC_FAKE_KMOE=1 bun scripts/dev.ts",
    "build": "tsc -b && vite build",
    "build:demo": "vite build --mode demo",
    "start": "bun server/index.ts",
    "typecheck": "tsc -b",
    "test": "bun test --timeout 30000",
    "check": "tsc -b && bun test --timeout 30000 && vite build",
    "compile": "bun build server/index.ts --compile --minify --sourcemap --outfile dist-server/kmoesync"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.170.32",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-cjk-friendly": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
